# Build-time: public URL of v2-admin (trailing slash optional). Enables direct SSE + fastest sync.
# Production demo-api (Render):
# VITE_V2_ADMIN_URL=https://demo-api-k8p3.onrender.com
#
# Legacy v2-admin on Render (if not using demo-api):
# Example: https://salonx-demo-admin.onrender.com
#
# If unset: the app uses same-origin `/salonx-admin` — Vercel rewrites (see vercel.json), or in dev
# Vite proxies to local Next (default http://localhost:3000; override with V2_ADMIN_PROXY_TARGET in .env).
#
# Appointments are stored in whatever DATABASE_URL that v2-admin instance uses. Prisma Studio must
# use the same DATABASE_URL to see rows (remote Render DB vs local .env are different).
# VITE_V2_ADMIN_URL=https://demo-api-k8p3.onrender.com
#
# Dev: VITE_V2_ADMIN_URL is ignored (requests go to /salonx-admin → local v2-admin). To hit remote
# from Vite anyway: VITE_DEV_USE_REMOTE_V2_ADMIN=true
# VITE_DEV_USE_REMOTE_V2_ADMIN=true
#
# --- Dev: point the web app at demo-api (Express) instead of Next v2-admin ---
# Vite proxies `/salonx-demo-api` → http://localhost:4000 (override with VITE_DEMO_API_PROXY_TARGET).
# VITE_DEV_USE_DEMO_API=true
# VITE_DEMO_API_PROXY_TARGET=http://localhost:4000
